# TrackingHub local development defaults.
# Copy this file to .env.local or export the variables in your runtime.

# Postgres metadata store. Enables auth, projects, environments, SDK keys,
# event dictionary, and metadata-backed schema validation.
TRACKINGHUB_POSTGRES_URL=postgres://trackinghub:trackinghub@localhost:15432/trackinghub

# ClickHouse event persistence and analytics.
TRACKINGHUB_CLICKHOUSE_URL=http://localhost:18123
TRACKINGHUB_CLICKHOUSE_DATABASE=trackinghub
TRACKINGHUB_CLICKHOUSE_USERNAME=writer
TRACKINGHUB_CLICKHOUSE_PASSWORD=secret

# Host ports used by docker-compose.yml. Container-to-container connections keep
# the standard internal ports, while host bindings avoid common local conflicts.
TRACKINGHUB_WEB_PORT=3000
TRACKINGHUB_POSTGRES_PORT=15432
TRACKINGHUB_CLICKHOUSE_HTTP_PORT=18123
TRACKINGHUB_CLICKHOUSE_NATIVE_PORT=19000

# Production safety switch. Keep true for shared or production deployments so
# /api/events and /api/logs return 503 instead of accepting data into a no-op
# writer when ClickHouse is missing.
TRACKINGHUB_REQUIRE_EVENT_PERSISTENCE=true
TRACKINGHUB_REQUIRE_LOG_PERSISTENCE=true

# Production analytics/reporting switch. Keep true in shared or production
# deployments so missing ClickHouse is surfaced as unavailable real data.
TRACKINGHUB_REQUIRE_REAL_DATA=true

# Production admin bootstrap. Use `pnpm --filter web bootstrap:admin -- --dry-run`
# first, then run without --dry-run after reviewing the values.
TRACKINGHUB_ADMIN_EMAIL=
TRACKINGHUB_ADMIN_PASSWORD=
TRACKINGHUB_ADMIN_NAME=平台管理员
TRACKINGHUB_WORKSPACE_NAME=TrackingHub

# Magic Frame App formal project import. Provide these when running
# `pnpm --filter web import:magic-frame` to create Flutter SDK write keys for
# each environment.
TRACKINGHUB_MAGIC_FRAME_FLUTTER_TEST_WRITE_KEY=
TRACKINGHUB_MAGIC_FRAME_FLUTTER_DEVELOP_WRITE_KEY=
TRACKINGHUB_MAGIC_FRAME_FLUTTER_PRODUCTION_WRITE_KEY=
